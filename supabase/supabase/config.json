{
  "project": "CosmaCare Layer-3",
  "description": "Supabase schema + triggers + workers for CosmaCare",
  "version": "1.0.0",
  "tables": [
    "profiles",
    "services",
    "bookings",
    "settlements",
    "disputes",
    "rewards"
  ],
  "realtime": {
    "channel": "cosmacare",
    "events": [
      "booking.created",
      "booking.confirmed",
      "booking.completed",
      "booking.settled",
      "booking.disputed",
      "dispute.resolved",
      "rewards.minted",
      "profile.updated"
    ]
  }
}

